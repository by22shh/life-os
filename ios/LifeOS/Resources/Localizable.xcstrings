        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast local reuse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрое локальное повторное использование"
          }
        }
      }
    },
    "settings_food_data_sources_priority_third_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Open Food Facts lookup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
