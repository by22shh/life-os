          "stringUnit": {
            "state": "translated",
            "value": "Requested only when needed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивается только при необходимости"
          }
        }
      }
    },
    "settings_food_data_sources_review_privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Privacy Controls"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить настройки приватности"
          }
        }
      }
    },
    "settings_food_data_sources_source_ocr_badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo or scan derived"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из фото или скана"
          }
        }
      }
    },
    "settings_food_data_sources_source_ocr_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a barcode match is unavailable, Life OS can fall back to nutrition labels extracted from scans. OCR can miss serving sizes, units, or lines on difficult packaging, so review before logging."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда совпадение по штрихкоду недоступно, Life OS может использовать данные этикетки, извлечённые из сканов. OCR может пропускать размеры порций, единицы измерения или строки на сложной упаковке, поэтому проверяйте данные перед логированием."
          }
        }
      }
    },
    "settings_food_data_sources_source_ocr_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label scan OCR fallback"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервное OCR-распознавание этикетки"
          }
        }
      }
    },
    "settings_food_data_sources_source_off_badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External community data"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внешние данные сообщества"
          }
        }
      }
    },
    "settings_food_data_sources_source_off_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for barcode and search lookups when local data is not enough. Entries can be incomplete, outdated, or specific to another region or package revision."
          }
        },
        "ru": {
