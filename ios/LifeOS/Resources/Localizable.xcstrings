    "training_zone_desc_undertraining": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your training load is below baseline. Consider increasing intensity or volume gradually."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировочная нагрузка ниже базовой. Рассмотрите постепенное увеличение интенсивности."
          }
        }
      }
    },
    "training_zone_desc_optimal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your training load is well-balanced. Keep up the good work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировочная нагрузка сбалансирована. Продолжайте в том же духе."
          }
        }
      }
    },
    "training_zone_desc_overreaching": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load is elevated. Monitor recovery closely and consider a deload."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагрузка повышена. Следите за восстановлением и рассмотрите разгрузку."
          }
        }
      }
    },
    "training_zone_desc_injury_risk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load spike detected. High injury risk — reduce intensity and prioritize recovery."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резкий рост нагрузки. Высокий риск травмы — снизьте интенсивность."
          }
        }
      }
    },
