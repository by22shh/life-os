    "runtime_banner_auth_local_profile_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account was restored, but local profile setup did not finish. Some screens may show incomplete data until the next retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт восстановлен, но локальный профиль не был полностью подготовлен. Некоторые экраны могут показывать неполные данные до следующей попытки."
          }
        }
      }
    },
    "runtime_banner_auth_cloud_reconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud session ended. Local data stays on this device. Reconnect the account to resume sync and export."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачная сессия завершилась. Локальные данные остались на этом устройстве. Переподключите аккаунт, чтобы снова работали синхронизация и экспорт."
          }
        }
      }
    },
    "runtime_banner_auth_state_refresh_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not refresh your local account state. Some screens may show stale data until the next retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить локальное состояние аккаунта. Некоторые экраны могут показывать устаревшие данные до следующей попытки."
          }
        }
      }
    },
    "runtime_banner_cloud_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud sync did not finish. Local changes remain on this device and the app will retry automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачная синхронизация не завершилась. Локальные изменения остались на устройстве, и приложение повторит попытку автоматически."
          }
        }
      }
    },
    "runtime_banner_daily_state_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's health state did not refresh. Recovery and readiness insights may be temporarily outdated."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние здоровья за сегодня не обновилось. Инсайты по восстановлению и готовности могут временно быть устаревшими."
          }
        }
      }
    },
    "runtime_banner_guardian_authorization_revoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Control permission was revoked. Guardian switched to Protective."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение Focus Control было отозвано. Guardian переключён в режим Protective."
          }
        }
      }
    },
    "runtime_banner_privacy_maintenance_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy maintenance did not finish. Retention cleanup will retry automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обслуживание приватности не завершилось. Очистка по политикам хранения будет автоматически повторена."
          }
        }
      }
    },
