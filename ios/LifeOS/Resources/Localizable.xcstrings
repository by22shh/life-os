    "settings_food_data_sources_cache_catalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts matches are cached locally for up to 30 days to speed up repeat scans and improve resilience when you are offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадения Open Food Facts кэшируются локально до 30 дней, чтобы ускорить повторные сканы и повысить устойчивость работы офлайн."
          }
        }
      }
    },
    "settings_food_data_sources_cache_ocr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR-derived label entries can remain available in the catalog and be reused for future barcode matches until newer data replaces them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карточки, полученные через OCR этикетки, могут оставаться доступными в каталоге и переиспользоваться для будущих совпадений по штрихкоду, пока их не заменят более новые данные."
          }
        }
      }
    },
    "settings_food_data_sources_cache_photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Food photos stored on device are automatically cleaned up after 90 days."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографии продуктов, сохранённые на устройстве, автоматически очищаются через 90 дней."
          }
        }
      }
    },
    "settings_food_data_sources_caching_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caching and Retention"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэширование и хранение"
          }
        }
      }
    },
    "settings_food_data_sources_cloud_ocr_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off Cloud OCR disables cloud-based label extraction. Barcode lookup and saved foods continue to work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение Cloud OCR выключает облачное извлечение данных с этикеток. Поиск по штрихкоду и сохранённые продукты продолжат работать."
          }
        }
      }
    },
    "settings_food_data_sources_controls_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud OCR preference is stored in Privacy settings and can be changed at any time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка Cloud OCR хранится в разделе приватности и может быть изменена в любой момент."
          }
        }
      }
    },
    "settings_food_data_sources_controls_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls and Verification"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление и проверка"
          }
        }
      }
    },
    "settings_food_data_sources_external_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts is an external service not operated by Life OS. Availability, terms, and data practices are governed by that service."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts является внешним сервисом и не управляется Life OS. Доступность, условия использования и практики работы с данными определяются этим сервисом."
          }
        }
      }
    },
    "settings_food_data_sources_external_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "External Source Disclosure"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскрытие информации о внешнем источнике"
          }
        }
      }
    },
    "settings_food_data_sources_intro_primary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Life OS first tries foods you created or corrected yourself, then recent catalog matches already stored on this device, and only then external or OCR-derived sources when local data is missing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Life OS сначала использует продукты, которые вы сами создали или исправили, затем недавние совпадения из каталога, уже сохранённые на этом устройстве, и только потом внешние или OCR-источники, если локальных данных недостаточно."
          }
        }
      }
    },
    "settings_food_data_sources_intro_secondary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This keeps repeat logging fast, improves offline behavior, and lets your own corrections win over generic catalog entries."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ускоряет повторное логирование, улучшает работу офлайн и делает ваши собственные исправления приоритетнее типовых карточек каталога."
          }
        }
      }
    },
    "settings_food_data_sources_lookup_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Lookup Works"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как работает поиск"
          }
        }
      }
    },
    "settings_food_data_sources_open_food_facts_link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts website"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт Open Food Facts"
          }
        }
      }
    },
    "settings_food_data_sources_precision_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community and OCR-derived nutrition data should be treated as assistive input, not as a substitute for the package label when precision matters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о питательной ценности из сообщества и OCR следует воспринимать как вспомогательный источник, а не как замену этикетке на упаковке, когда важна точность."
          }
        }
      }
    },
    "settings_food_data_sources_priority_first_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Your foods and barcode overrides"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ваши продукты и переопределения штрихкодов"
          }
        }
      }
    },
    "settings_food_data_sources_priority_first_value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется первым"
          }
        }
      }
    },
    "settings_food_data_sources_priority_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search follows the same principle: local foods and recent catalog matches rank ahead of provider results."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск работает по тому же принципу: локальные продукты и недавние совпадения каталога ранжируются выше результатов провайдера."
          }
        }
      }
    },
    "settings_food_data_sources_priority_fourth_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. OCR-derived label fallback"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Резервный OCR по этикетке"
          }
        }
      }
    },
    "settings_food_data_sources_priority_fourth_value": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used after provider miss"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется после промаха у провайдера"
          }
        }
      }
    },
    "settings_food_data_sources_priority_header": {
      "extractionState": "manual",
      "localizations": {
