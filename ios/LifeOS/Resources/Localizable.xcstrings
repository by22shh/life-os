    "settings_emergency_override_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This disables Guardian until tomorrow on this device. Use it only when you need immediate access and cannot wait for the current restriction window to end."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это отключит Guardian на этом устройстве до завтра. Используйте только если вам нужен немедленный доступ и вы не можете дождаться окончания текущего окна ограничений."
          }
        }
      }
    },
    "settings_emergency_override_hold_button": {
