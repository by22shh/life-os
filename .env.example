# Life OS environment variables — copy to `.env` and fill in.
# Every variable below is referenced by supabase/functions (Deno.env.get),
# scripts/*.sh, or ios/project.yml Release config. See supabase/DEPLOYMENT.md.

# --- Supabase backend (edge functions runtime; scripts/run_supabase_edge_e2e.sh) ---
SUPABASE_URL=https://your-project-ref.supabase.co          # Project URL read by supabase/functions/_shared/supabase.ts
SUPABASE_ANON_KEY=your-anon-key                            # Public anon key; used for user-context requests
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key            # Server-only key; used by workers and local test harnesses. NEVER ship to clients
SUPABASE_ACCESS_TOKEN=sbp_your-access-token                # Supabase CLI access token; required by scripts/run_nutrition_provider_live_smoke.sh and deploys

# --- OpenRouter (AI endpoints: ai/openrouter-gateway, analyze-food-image, analyze-food-label, analyze-batch-recipe-image, api/insights/predict) ---
OPENROUTER_API_KEY=sk-or-your-openrouter-key               # Server-side key so AI calls never touch the client
OPENROUTER_REFERER=https://lifeos.app                      # Sent as HTTP-Referer to OpenRouter (optional ranking signal)
OPENROUTER_APP_NAME=Life OS                                # Sent as X-Title to OpenRouter (defaults to "Life OS")

# --- Optional server-only AI memory (never include these in iOS builds) ---
PINECONE_INDEX_HOST=your-index.svc.region.pinecone.io      # Existing dense index; dimension must match embedding model
PINECONE_API_KEY=your-pinecone-api-key
VECTOR_EMBEDDING_MODEL=openai/text-embedding-3-small       # Default 1536-dimensional model; changing requires reindexing

# Optional per-endpoint model overrides (fall back to code defaults when unset)
ANALYZE_FOOD_IMAGE_MODEL=openrouter/default-vision-model   # Model override for analyze-food-image
ANALYZE_FOOD_LABEL_MODEL=openrouter/default-vision-model   # Model override for analyze-food-label
ANALYZE_BATCH_RECIPE_MODEL=openrouter/default-vision-model # Model override for analyze-batch-recipe-image

# --- APNs push notifications (supabase/functions/_shared/apns.ts) ---
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID                            # Apple Developer team ID
APNS_KEY_ID=YOUR_APNS_KEY_ID                               # Key ID of the .p8 signing key
APNS_PRIVATE_KEY_P8=-----BEGIN PRIVATE KEY-----...         # Contents of AuthKey_<KEY_ID>.p8
APNS_BUNDLE_ID=com.lifeos.app                              # App bundle ID used as APNs topic

# --- Server-managed force-update headers (supabase/functions/_shared/cors.ts) ---
MIN_SUPPORTED_APP_VERSION=1.0.0                            # Hard floor; older app versions are blocked (X-Min-App-Version)
SOFT_UPDATE_VERSION=1.1.0                                  # Soft-update nudge version (X-Soft-Update-Version)
APP_STORE_URL=https://apps.apple.com/app/id1234567890      # Direct product URL emitted as X-App-Store-URL (must be absolute https, not a search page)
APP_STORE_ID=1234567890                                    # Numeric App Store ID used to build X-App-Store-URL when APP_STORE_URL is unset/degraded

# --- Networking hardening ---
CORS_ALLOWED_ORIGINS=https://app.lifeos.example            # Comma-separated exact origins allowlist; leave empty for default behavior
OPS_ALERT_WEBHOOK_URL=https://hooks.example.com/lifeos-ops # Webhook sink for ops-alert-dispatch alerts (optional)

# --- Nutrition provider (supabase/functions/_shared/foods_provider.ts) ---
FOODS_PROVIDER_ENABLED=1                                   # 1/true enables remote catalog provider; 0/false disables (local tests default to 0)
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org   # Override only for staging/proxies
OPEN_FOOD_FACTS_USER_AGENT=LifeOS/1.0 (support@lifeos.app) # User-Agent sent to Open Food Facts
OPEN_FOOD_FACTS_BARCODE_TIMEOUT_MS=5000                    # Barcode lookup timeout in ms
OPEN_FOOD_FACTS_SEARCH_TIMEOUT_MS=5000                     # Search request timeout in ms

# --- iOS build (ios/project.yml Release config; validated by scripts/check_ios_release_config.sh) ---
LIFEOS_SUPABASE_URL=https://your-project-ref.supabase.co   # Resolves Release SUPABASE_URL build setting injected into Info.plist
LIFEOS_SUPABASE_ANON_KEY=your-anon-key                     # Resolves Release SUPABASE_ANON_KEY build setting injected into Info.plist

# --- iOS live backend smoke (scripts/run_ios_live_backend_smoke.sh) ---
LIFEOS_UI_TEST_LIVE_SUPABASE_URL=https://your-project-ref.supabase.co # Hosted project URL for UI-test live backend smoke (optional; falls back to local Supabase)
LIFEOS_UI_TEST_LIVE_SUPABASE_ANON_KEY=your-anon-key        # Matching anon key for the live smoke run
