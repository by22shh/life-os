# macOS filesystem noise
.DS_Store

# Generated build and profiling artifacts
/ios/build/
/output/
/tmp/
*.xcresult
*.trace
DerivedData/

# Logs
/release_gate*.log
*.log

# Tool and coverage caches (regenerable)
/.serena/
/.supergoal/
/scripts/__pycache__/
__pycache__/
/.codex-tmp/
/.coverage/
/.deno-coverage-functions*/

# Environment / secrets — never commit
.env
.env.*
!.env.example

# Key/certificate material — never commit (defense in depth: one careless
# `cp AuthKey.p8 .` must not be able to land in a commit)
*.p8
*.pem
*.key
*.mobileprovision
*.cer
*.p12
*.pfx

# Xcode user-local release configs (LIFEOS_SUPABASE_* secrets live there)
*.xcconfig.local

# Audit phase logs and traces are heavy regenerable evidence; keep audit reports/screenshots tracked
audits/*/phase-*-logs/
audits/*/phase-*-traces/

# Python
.venv/

# SwiftPM
.build/

# nested coverage artifacts
supabase/.coverage/

# Supabase CLI runtime credentials generated when starting Edge Runtime locally
supabase/.temp/start-secrets/
